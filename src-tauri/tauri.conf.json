{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestra",
  "version": "0.4.2",
  "identifier": "dev.orchestra.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orchestra",
        "width": 1500,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0d0f12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "jonirulah",
    "shortDescription": "Terminal, SSH and AI-agent manager for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNjY2OUNGREYyQTc2Q0IKUldUTGRpcmZ6MmxtSDNRTStTV25RRnROajNEQ0l0WEVPVGNoTUVCbEI4RGJFeWh3SWRWeE5oYmkK",
      "endpoints": [
        "https://github.com/Jonirulah/Orchestra/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
